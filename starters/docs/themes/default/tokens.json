{
  "color-critical": {
    "$type": "color",
    "text": { "$value": "#1a202c", "$description": "Primary text color" },
    "text-light": { "$value": "#4a5568", "$description": "Secondary text color" },
    "background": { "$value": "#ffffff", "$description": "Page background" },
    "background-alt": { "$value": "#f7fafc", "$description": "Alternate background" },
    "border": { "$value": "#e2e8f0", "$description": "Border color" },
    "primary": { "$value": "#3182ce", "$description": "Primary brand color" }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": { "value": 1.5, "unit": "rem" } },
    "sm": { "$value": { "value": 0.5, "unit": "rem" } },
    "md": { "$value": { "value": 1, "unit": "rem" } },
    "lg": { "$value": { "value": 2, "unit": "rem" } },
    "xl": { "$value": { "value": 4, "unit": "rem" } }
  },
  "layout": {
    "max-width": {
      "$type": "dimension",
      "$value": { "value": 48, "unit": "rem" }
    }
  },
  "typography": {
    "sans": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, sans-serif"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "Georgia, Cambria, 'Times New Roman', serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "'Monaco', 'Menlo', monospace"
    }
  }
}
